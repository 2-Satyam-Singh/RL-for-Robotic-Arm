<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="robot_dog">
    <static>false</static>

    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose> 
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.08</iyy><izz>0.09</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_vis">
        <geometry><box><size>0.4 0.2 0.1</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="base_col">
        <geometry><box><size>0.4 0.2 0.1</size></box></geometry>
      </collision>
    </link>

    <!-- Front Left -->
    <joint name="joint_fl" type="revolute">
      <pose relative_to="base_link">0.15 0.12 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>leg_fl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>100.0</effort><velocity>5.0</velocity></limit>
        <dynamics><damping>2.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>
    <link name="leg_fl">
      <pose relative_to="joint_fl">0 0 -0.1 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="vis_fl"><geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry><material><ambient>0 0 1 1</ambient></material></visual>
      <collision name="col_fl">
        <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- Front Right -->
    <joint name="joint_fr" type="revolute">
      <pose relative_to="base_link">0.15 -0.12 0 0 0 0</pose>
      <parent>base_link</parent><child>leg_fr</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>100.0</effort><velocity>5.0</velocity></limit>
        <dynamics><damping>2.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>
    <link name="leg_fr">
      <pose relative_to="joint_fr">0 0 -0.1 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="vis_fr"><geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry><material><ambient>0 1 0 1</ambient></material></visual>
      <collision name="col_fr">
        <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- Back Left -->
    <joint name="joint_bl" type="revolute">
      <pose relative_to="base_link">-0.15 0.12 0 0 0 0</pose>
      <parent>base_link</parent><child>leg_bl</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>100.0</effort><velocity>5.0</velocity></limit>
        <dynamics><damping>2.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>
    <link name="leg_bl">
      <pose relative_to="joint_bl">0 0 -0.1 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="vis_bl"><geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry><material><ambient>1 0 0 1</ambient></material></visual>
      <collision name="col_bl">
        <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- Back Right -->
    <joint name="joint_br" type="revolute">
      <pose relative_to="base_link">-0.15 -0.12 0 0 0 0</pose>
      <parent>base_link</parent><child>leg_br</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>100.0</effort><velocity>5.0</velocity></limit>
        <dynamics><damping>2.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>
    <link name="leg_br">
      <pose relative_to="joint_br">0 0 -0.1 0 0 0</pose>
      <inertial><mass>0.5</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="vis_br"><geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry><material><ambient>1 1 0 1</ambient></material></visual>
      <collision name="col_br">
        <geometry><cylinder><radius>0.02</radius><length>0.2</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
    </link>

    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>joint_fl</joint_name>
      <joint_name>joint_fr</joint_name>
      <joint_name>joint_bl</joint_name>
      <joint_name>joint_br</joint_name>
      <p_gain>5000.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>100.0</d_gain>
      <cmd_max>100.0</cmd_max>
      <cmd_min>-100.0</cmd_min>
    </plugin>
  </model>
</sdf>
