<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="robot_3dof">
    <static>false</static>

    <joint name="world_joint" type="fixed">
      <parent>world</parent>
      <child>base_link</child>
    </joint>

    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose> 
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0066</ixx><iyy>0.0066</iyy><izz>0.01</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_vis">
        <geometry><cylinder><radius>0.1</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
      <collision name="base_col">
        <geometry><cylinder><radius>0.1</radius><length>0.1</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="joint1" type="revolute">
      <pose relative_to="base_link">0 0 0.05 0 0 0</pose>
      <parent>base_link</parent>
      <child>link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14</lower><upper>3.14</upper>
          <effort>500.0</effort><velocity>10</velocity> 
        </limit>
        <dynamics><damping>10.0</damping><friction>2.0</friction></dynamics>
      </axis>
    </joint>

    <link name="link1">
      <pose relative_to="joint1">0 0 0.15 0 0 0</pose> <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0083</ixx><iyy>0.0083</iyy><izz>0.0016</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="vis1">
        <geometry><box><size>0.1 0.1 0.3</size></box></geometry>
        <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
      </visual>
      <collision name="col1">
        <geometry><box><size>0.1 0.1 0.3</size></box></geometry>
      </collision>
    </link>

    <joint name="joint2" type="revolute">
      <pose relative_to="link1">0 0 0.15 0 0 0</pose> <parent>link1</parent>
      <child>link2</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.14</lower><upper>3.14</upper>
          <effort>500.0</effort><velocity>10</velocity> 
        </limit>
        <dynamics><damping>10.0</damping><friction>2.0</friction></dynamics>
      </axis>
    </joint>

    <link name="link2">
      <pose relative_to="joint2">0 0 0.35 0 0 0</pose> <inertial>
        <mass>2.33</mass> 
        <inertia>
          <ixx>0.097</ixx><iyy>0.097</iyy><izz>0.0038</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="vis2">
        <geometry><box><size>0.1 0.1 0.7</size></box></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
      <collision name="col2">
        <geometry><box><size>0.1 0.1 0.7</size></box></geometry>
      </collision>
    </link>

    <joint name="joint3" type="revolute">
      <pose relative_to="link2">0 0 0.35 0 0 0</pose> <parent>link2</parent>
      <child>link3</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.57</lower><upper>1.57</upper>
          <effort>500.0</effort><velocity>10</velocity> 
        </limit>
        <dynamics><damping>10.0</damping><friction>2.0</friction></dynamics>
      </axis>
    </joint>

    <link name="link3">
      <pose relative_to="joint3">0 0 0.25 0 0 0</pose> <inertial>
        <mass>1.66</mass> 
        <inertia>
          <ixx>0.036</ixx><iyy>0.036</iyy><izz>0.0027</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="vis3">
        <geometry><box><size>0.1 0.1 0.5</size></box></geometry> 
        <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
      </visual>
      <collision name="col3">
         <geometry><box><size>0.1 0.1 0.5</size></box></geometry>
      </collision>
    </link>
    
    <plugin filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
      <joint_name>joint1</joint_name>
      <joint_name>joint2</joint_name>
      <joint_name>joint3</joint_name>
      
      <p_gain>15000.0</p_gain>
      <i_gain>100.0</i_gain>
      <d_gain>500.0</d_gain>
      
      <cmd_max>1000.0</cmd_max>
      <cmd_min>-1000.0</cmd_min>
    </plugin>

  </model>
</sdf>