<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="world_6dof">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>10.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    
    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui><title>3D View</title><property type="string" key="state">docked</property></ignition-gui>
        <engine>ogre2</engine><scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light><background_color>0.8 0.8 0.8</background_color>
        <camera_pose>2 2 2 0 0.5 -2.5</camera_pose>
      </plugin>
      <plugin filename="JointPositionController" name="JointPositionController">
        <ignition-gui><property type="string" key="state">floating</property></ignition-gui>
        <model_name>robot_6dof</model_name>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>robot_6dof</uri>
      <pose>0.2 0 1.025 0 0 0</pose>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/model/robot_6dof/joint_state</topic>
      </plugin>
    </include>

    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri><name>table1</name><pose>0 0 0 0 0 1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri><name>table2</name><pose>0.794 0 0 0 0 1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/GoogleResearch/models/Transformers_Age_of_Extinction_Mega_1Step_Bumblebee_Figure</uri><pose>1 0 1.025 0 0 0</pose></include>
  </world>
</sdf>
